<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pago Seguro con Datafast</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
  
  <!-- Datafast COPYandPAY Widget Script -->
  <script src="<%= datafastBaseUrl %>/v1/paymentWidgets.js?checkoutId=<%= checkoutId %>"></script>
  
  <style>
    :root {
      --primary: #0070ba;
      --primary-hover: #005ea6;
      --emerald: #10b981;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --accent: #2563eb;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
    }

    .checkout-wrapper {
      width: 100%;
      max-width: 490px;
    }

    .card {
      background: var(--card-bg);
      border-radius: 24px;
      box-shadow: 0 10px 35px -5px rgba(15, 23, 42, 0.08), 0 0 0 1px var(--border);
      padding: 2.2rem 2rem;
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #2563eb, #00b389, #2563eb);
    }

    .header {
      text-align: center;
      margin-bottom: 1.8rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ecfdf5;
      color: #059669;
      font-size: 0.76rem;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 999px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 0.9rem;
      border: 1px solid #d1fae5;
    }

    .badge svg {
      width: 12px;
      height: 12px;
      fill: currentColor;
    }

    .title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
      margin-bottom: 0.35rem;
    }

    .subtitle {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .order-summary {
      background: #f8fafc;
      border: 1px solid #f1f5f9;
      border-radius: 16px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .order-summary .label {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .order-summary .name {
      font-size: 0.98rem;
      color: var(--text);
      font-weight: 600;
      margin-top: 2px;
    }

    .order-summary .price {
      font-size: 1.35rem;
      font-weight: 700;
      color: #059669;
    }

    /* COPYandPAY Customization */
    .wpwl-container {
      font-family: inherit !important;
    }

    .wpwl-form {
      max-width: 100% !important;
      padding: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }

    .wpwl-wrapper {
      margin-bottom: 1rem !important;
    }

    .wpwl-label {
      font-size: 0.82rem !important;
      font-weight: 600 !important;
      color: #334155 !important;
      margin-bottom: 5px !important;
      letter-spacing: 0.01em !important;
      display: block !important;
    }

    .wpwl-control {
      height: 46px !important;
      border-radius: 12px !important;
      border: 1.5px solid #cbd5e1 !important;
      font-size: 0.95rem !important;
      color: #0f172a !important;
      padding: 0 14px !important;
      background: #ffffff !important;
      transition: all 0.2s ease !important;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03) !important;
    }

    .wpwl-control:focus {
      border-color: #2563eb !important;
      outline: none !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }

    .wpwl-group-brand {
      margin-bottom: 1.25rem !important;
    }

    .wpwl-button-pay {
      background: linear-gradient(135deg, #059669, #047857) !important;
      color: #ffffff !important;
      border-radius: 12px !important;
      font-weight: 600 !important;
      font-size: 1.05rem !important;
      height: 50px !important;
      border: none !important;
      cursor: pointer !important;
      box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3) !important;
      transition: all 0.2s ease !important;
      width: 100% !important;
      margin-top: 1.2rem !important;
      letter-spacing: 0.01em !important;
    }

    .wpwl-button-pay:hover {
      background: linear-gradient(135deg, #047857, #065f46) !important;
      transform: translateY(-1px) !important;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.4) !important;
    }

    .wpwl-button-pay:active {
      transform: translateY(0) !important;
    }

    .footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      margin-top: 1.6rem;
      padding-top: 1.4rem;
      border-top: 1px solid var(--border);
    }

    .security-notice {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .security-notice svg {
      width: 14px;
      height: 14px;
      fill: #059669;
      flex-shrink: 0;
    }

    .security-brands {
      display: flex;
      gap: 12px;
      font-size: 0.72rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>

  <div class="checkout-wrapper">
    <div class="card">
      <div class="header">
        <div class="badge">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          Checkout Seguro
        </div>
        <h1 class="title">Completar Pago</h1>
        <p class="subtitle">Transacción segura procesada por Datafast</p>
      </div>

      <% if (locals.packageName || locals.amount) { %>
      <div class="order-summary">
        <div>
          <div class="label">Detalle del Producto</div>
          <div class="name"><%= locals.packageName || "Suscripción" %></div>
        </div>
        <% if (locals.amount) { %>
        <div class="price">$<%= Number(locals.amount).toFixed(2) %></div>
        <% } %>
      </div>
      <% } %>

      <!-- Formulario COPYandPAY de Datafast -->
      <form action="<%= callbackUrl %>" class="paymentWidgets" data-brands="VISA MASTER AMEX DINERS DISCOVER"></form>

      <!-- Testing Helper Info for Sandbox -->
      <div style="margin-top: 18px; padding: 14px 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; font-size: 0.8rem; color: #166534;">
        <div style="font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
          <span>💳</span> Tarjeta de Prueba (Sandbox)
        </div>
        <div style="display: grid; grid-template-columns: auto 1fr; gap: 4px 10px;">
          <span style="color: #15803d; font-weight: 600;">Número:</span>
          <code>4540 6300 0000 0000</code>
          <span style="color: #15803d; font-weight: 600;">Expira:</span>
          <span>12/28</span>
          <span style="color: #15803d; font-weight: 600;">CVV:</span>
          <span>123</span>
          <span style="color: #15803d; font-weight: 600;">Titular:</span>
          <span>Su Empresa</span>
        </div>
      </div>

      <div class="footer">
        <div class="security-notice">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          <span>Conexión cifrada SSL de 256 bits y certificación PCI-DSS</span>
        </div>
        <div class="security-brands">
          <span>Visa</span> • <span>Mastercard</span> • <span>Amex</span> • <span>Diners</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Script Oficial de Validaciones Datafast -->
  <script type="text/javascript" src="https://www.datafast.com.ec/js/dfAdditionalValidations1.js"></script>
</body>
</html>
