<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice - <%= invoiceNumber %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #22843F;
      --primary-light: rgba(34, 132, 63, 0.08);
      --primary-border: rgba(34, 132, 63, 0.2);
      --bg: #FFFFFF;
      --text-main: #282B32;
      --text-muted: #6C727F;
      --border-color: #E6E8EC;
      --table-header-bg: #F8FAF9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    @page {
      size: A4 portrait;
      margin: 12mm 15mm;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        background-color: var(--bg) !important;
      }
      .page-container {
        padding: 0 !important;
        box-shadow: none !important;
      }
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 13px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    .page-container {
      max-width: 820px;
      margin: 0 auto;
      background: var(--bg);
      padding: 24px;
    }

    /* Top Accent Line */
    .top-bar {
      height: 6px;
      background: linear-gradient(90deg, #22843F 0%, #2ecc71 100%);
      border-radius: 4px;
      margin-bottom: 28px;
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 32px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .brand-title {
      font-size: 26px;
      font-weight: 700;
      color: var(--primary);
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-tagline {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
      font-weight: 500;
    }

    .invoice-title-block {
      text-align: right;
    }

    .invoice-heading {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 1px;
      color: var(--text-main);
      text-transform: uppercase;
      line-height: 1;
    }

    .invoice-number {
      font-size: 14px;
      font-weight: 600;
      color: var(--primary);
      margin-top: 6px;
    }

    .badge-paid {
      display: inline-block;
      margin-top: 8px;
      padding: 4px 12px;
      background-color: var(--primary-light);
      border: 1px solid var(--primary-border);
      color: var(--primary);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border-radius: 999px;
    }

    /* Info Cards Grid */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      margin-bottom: 32px;
    }

    .info-card {
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 16px 18px;
    }

    .info-card-header {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--primary);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .info-card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .info-card-meta {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .info-card-meta strong {
      color: var(--text-main);
      font-weight: 600;
    }

    /* Meta Table */
    .meta-table {
      width: 100%;
      border-collapse: collapse;
    }

    .meta-table td {
      padding: 3px 0;
      font-size: 12px;
    }

    .meta-table td.label {
      color: var(--text-muted);
      width: 45%;
    }

    .meta-table td.value {
      color: var(--text-main);
      font-weight: 600;
      text-align: right;
    }

    /* Items Table */
    .items-section {
      margin-bottom: 28px;
    }

    .items-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
    }

    .items-table th {
      background-color: var(--table-header-bg);
      color: var(--text-main);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }

    .items-table th.text-right {
      text-align: right;
    }

    .items-table th.text-center {
      text-align: center;
    }

    .items-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-color);
      font-size: 13px;
      vertical-align: top;
    }

    .items-table tr:last-child td {
      border-bottom: none;
    }

    .items-table tr:nth-child(even) td {
      background-color: #FAFBFC;
    }

    .item-name {
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 3px;
    }

    .item-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .item-tag {
      display: inline-block;
      background-color: var(--primary-light);
      color: var(--primary);
      font-size: 10px;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 4px;
      margin-top: 4px;
    }

    /* Summary Section */
    .summary-container {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 36px;
      gap: 24px;
    }

    .notes-box {
      flex: 1;
      background: #FAFBFC;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 16px;
    }

    .notes-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 6px;
    }

    .notes-content {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .calculation-box {
      width: 320px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
      background: #FFFFFF;
    }

    .calc-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 16px;
      font-size: 12px;
      color: var(--text-muted);
      border-bottom: 1px solid #F1F3F5;
    }

    .calc-row.highlight {
      background-color: var(--primary-light);
      border-top: 1px solid var(--primary-border);
      border-bottom: none;
      padding: 14px 16px;
      align-items: center;
    }

    .calc-row.highlight .calc-label {
      font-size: 14px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
    }

    .calc-row.highlight .calc-value {
      font-size: 20px;
      font-weight: 800;
      color: var(--primary);
    }

    .calc-value {
      font-weight: 600;
      color: var(--text-main);
    }

    /* Verification Stamp */
    .stamp-container {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: var(--primary-light);
      border: 1px dashed var(--primary);
      border-radius: 8px;
      margin-bottom: 28px;
    }

    .stamp-icon {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background-color: var(--primary);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
    }

    .stamp-text {
      font-size: 12px;
      color: var(--primary);
      font-weight: 600;
    }

    /* Footer */
    .footer {
      border-top: 1px solid var(--border-color);
      padding-top: 18px;
      text-align: center;
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .footer strong {
      color: var(--text-main);
    }
  </style>
</head>
<body>
  <div class="page-container">
    <!-- Top Decorative Line -->
    <div class="top-bar"></div>

    <!-- Header Section -->
    <div class="header">
      <div>
        <div class="brand-title">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22843F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
          Productos Y Servicios
        </div>
        <div class="brand-tagline">Official Payment Invoice & Service Receipt</div>
      </div>

      <div class="invoice-title-block">
        <div class="invoice-heading">Invoice</div>
        <div class="invoice-number"><%= invoiceNumber %></div>
        <div><span class="badge-paid"><%= paymentStatus || 'PAID' %></span></div>
      </div>
    </div>

    <!-- Info Cards Grid -->
    <div class="info-grid">
      <!-- Billed To -->
      <div class="info-card">
        <div class="info-card-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22843F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Billed To
        </div>
        <div class="info-card-title"><%= customer.name || 'Valued Customer' %></div>
        <div class="info-card-meta">
          <% if (customer.email) { %>
            <div><strong>Email:</strong> <%= customer.email %></div>
          <% } %>
          <% if (customer.phone) { %>
            <div><strong>Phone:</strong> <%= customer.phone %></div>
          <% } %>
          <% if (store && store.displayName) { %>
            <div><strong>Store:</strong> <%= store.displayName %></div>
          <% } %>
          <% if (store && store.address) { %>
            <div><strong>Address:</strong> <%= store.address %></div>
          <% } %>
        </div>
      </div>

      <!-- Payment & Transaction Details -->
      <div class="info-card">
        <div class="info-card-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22843F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
          Payment Information
        </div>
        <table class="meta-table">
          <tr>
            <td class="label">Invoice Date:</td>
            <td class="value"><%= date %></td>
          </tr>
          <tr>
            <td class="label">Payment Method:</td>
            <td class="value"><%= paymentMethod || 'Online Payment' %></td>
          </tr>
          <% if (trxId) { %>
            <tr>
              <td class="label">Transaction Ref:</td>
              <td class="value" style="font-family: monospace; font-size: 11px;"><%= trxId %></td>
            </tr>
          <% } %>
          <tr>
            <td class="label">Currency:</td>
            <td class="value"><%= currency || 'USD' %></td>
          </tr>
        </table>
      </div>
    </div>

    <!-- Line Items Table -->
    <div class="items-section">
      <table class="items-table">
        <thead>
          <tr>
            <th style="width: 5%;">#</th>
            <th style="width: 50%;">Item & Description</th>
            <th style="width: 15%;" class="text-center">Type</th>
            <th style="width: 15%;" class="text-right">Unit Price</th>
            <th style="width: 15%;" class="text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(function(item, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <div class="item-name"><%= item.description %></div>
                  <% if (item.details) { %>
                    <div class="item-desc"><%= item.details %></div>
                  <% } %>
                  <% if (item.duration) { %>
                    <span class="item-tag">Duration: <%= item.duration %></span>
                  <% } %>
                </td>
                <td class="text-center"><%= item.type || 'Subscription' %></td>
                <td class="text-right">$<%= Number(item.unitPrice || 0).toFixed(2) %></td>
                <td class="text-right" style="font-weight: 700; color: var(--text-main);">$<%= Number(item.total || 0).toFixed(2) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td>1</td>
              <td>
                <div class="item-name">Platform Subscription / Service</div>
                <div class="item-desc">Online payment for platform services</div>
              </td>
              <td class="text-center">Subscription</td>
              <td class="text-right">$<%= Number(total || 0).toFixed(2) %></td>
              <td class="text-right" style="font-weight: 700;">$<%= Number(total || 0).toFixed(2) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Summary / Totals -->
    <div class="summary-container">
      <div class="notes-box">
        <div class="notes-title">Customer Support & Inquiries</div>
        <div class="notes-content">
          <%= notes || 'Thank you for choosing Productos Y Servicios. If you have any questions regarding this invoice, please reach out to our billing team at support@productosyservicios.com or via your mobile dashboard.' %>
        </div>
      </div>

      <div class="calculation-box">
        <div class="calc-row">
          <span class="calc-label">Subtotal</span>
          <span class="calc-value">$<%= Number(subtotal !== undefined ? subtotal : total).toFixed(2) %></span>
        </div>
        <div class="calc-row">
          <span class="calc-label">Taxes & Fees (IVA 0%)</span>
          <span class="calc-value">$<%= Number(tax || 0).toFixed(2) %></span>
        </div>
        <% if (discount && discount > 0) { %>
          <div class="calc-row">
            <span class="calc-label">Discount</span>
            <span class="calc-value">-$<%= Number(discount).toFixed(2) %></span>
          </div>
        <% } %>
        <div class="calc-row highlight">
          <span class="calc-label">Amount Paid</span>
          <span class="calc-value">$<%= Number(total || 0).toFixed(2) %> <%= currency || 'USD' %></span>
        </div>
      </div>
    </div>

    <!-- Verification Notice Banner -->
    <div class="stamp-container">
      <div class="stamp-icon">✓</div>
      <div class="stamp-text">
        Verified Electronic Receipt: This invoice confirms full payment settled for your subscription on <%= date %>.
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p><strong>Productos Y Servicios Inc.</strong> &bull; All Rights Reserved &bull; Secure Digital Transaction</p>
      <p>This is a computer-generated invoice and requires no physical signature.</p>
    </div>
  </div>
</body>
</html>
